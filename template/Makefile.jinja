# Project tasks. CI runs format-dry-run, build, test and release.

NAME := {{ project_slug }}
# CI passes the version it releases; local builds fall back to git describe
ifndef VERSION
VERSION := $(or $(patsubst v%,%,$(shell git describe --tags --match 'v[0-9]*' 2>/dev/null)),0.0.0)
endif
RELEASE_TARGETS := {% for target in release_targets if target != 'none' %}{{ target }}{% if not loop.last %} {% endif %}{% endfor %}

{% if language == 'C' -%}
COMPILER := gcc
ZIG_COMPILER := cc
STANDARD := gnu11
SOURCES := $(wildcard src/*.c)
{%- else -%}
COMPILER := g++
ZIG_COMPILER := c++
STANDARD := gnu++20
SOURCES := $(wildcard src/*.cpp)
{%- endif %}
HEADERS := $(wildcard src/*.h)

# debug.h relies on the GNU ##__VA_ARGS__ extension, hence the gnu standards
FLAGS := -std=$(STANDARD) -Wall -Wextra -Wshadow -Werror \
	-DPROJECT_NAME='"$(NAME)"' -DPROJECT_VERSION='"$(VERSION)"'

# debug.h keeps its own layout
FORMATTED := $(filter-out src/debug.h,$(SOURCES) $(HEADERS))

.PHONY: build format format-dry-run test release FORCE

build: build/$(NAME)

build/$(NAME): $(SOURCES) $(HEADERS) build/version
	@mkdir -p build
	$(COMPILER) $(FLAGS) -g -O0 -o $@ $(SOURCES)

# only rewritten when the version changes, so the binary is rebuilt with the new one compiled in
build/version: FORCE
	@mkdir -p build
	@echo '$(VERSION)' | cmp -s - $@ || echo '$(VERSION)' > $@

format:
	clang-format -i $(FORMATTED)

format-dry-run:
	clang-format --dry-run --Werror $(FORMATTED)

test: build
	cppcheck --enable=warning,style,performance,portability --error-exitcode=1 \
		--inline-suppr --quiet --suppress=missingIncludeSystem \
		--std={{ 'c++20' if language == 'C++' else 'c11' }} -DPROJECT_NAME='"$(NAME)"' \
		-DPROJECT_VERSION='"$(VERSION)"' -I src src
	./tests/cli.sh build/$(NAME) $(VERSION)

release:
	./scripts/release.sh $(NAME) "$(RELEASE_TARGETS)" $(ZIG_COMPILER) \
		$(FLAGS) -O2 -s -DNODEBUG $(SOURCES)
